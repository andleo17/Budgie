# Budgie — plantilla de configuración
# Copia este archivo a .env y rellena los valores antes de ejecutar `docker compose up -d`.

# --- API ---
# Entorno de ejecución (Development | Production)
ASPNETCORE_ENVIRONMENT=Production
# Puerto del host al que se expone la API/frontend (el contenedor escucha en el 80)
BUDGIE_PORT=80

# --- Base de datos ---
# Host de la base de datos (nombre del servicio en la red de compose)
DB_HOST=db
# Puerto del host al que se expone PostgreSQL
DB_PORT=5432
POSTGRES_DB=budgie
POSTGRES_USER=budgie
# OBLIGATORIO: contraseña segura de PostgreSQL
POSTGRES_PASSWORD=

# --- JWT ---
# OBLIGATORIO: clave de firma JWT (mínimo 32 caracteres)
JWT_SECRET=
JWT_ISSUER=Budgie
JWT_AUDIENCE=Budgie
