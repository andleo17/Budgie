# Budgie — plantilla de configuración
# Copia este archivo a .env y rellena los valores antes de ejecutar `docker compose up -d`.

# --- API ---
# Entorno de ejecución (Development | Production)
ASPNETCORE_ENVIRONMENT=Production
# Puerto del host al que se expone la API/frontend (el contenedor escucha en el 80)
BUDGIE_PORT=80

# --- Base de datos ---
# Host de la base de datos (nombre del servicio en la red de compose)
DB_HOST=db
# Puerto del host al que se expone PostgreSQL
DB_PORT=5432
POSTGRES_DB=budgie
POSTGRES_USER=budgie
# OBLIGATORIO: contraseña segura de PostgreSQL
POSTGRES_PASSWORD=

# --- JWT ---
# OBLIGATORIO: clave de firma JWT (mínimo 32 caracteres)
JWT_SECRET=
JWT_ISSUER=Budgie
JWT_AUDIENCE=Budgie

# --- Registro ---
# Controla si se permite el registro de nuevos usuarios.
# Auto   -> solo el primer usuario puede registrarse (por defecto)
# Open   -> el registro siempre está habilitado
# Closed -> el registro siempre está deshabilitado
REGISTRATION_MODE=Auto

# --- Importación de transacciones por correo (EmailImport) ---
# Activa el worker de sincronización en segundo plano (true/false).
# Con false el worker no se registra: la sincronización solo puede lanzarse a demanda
# (POST /api/email-import/sync). Por defecto false; actívalo por variable de entorno.
EMAILIMPORT_ENABLED=false
# Minutos entre sincronizaciones automáticas del worker.
EMAILIMPORT_SYNCINTERVALMINUTES=10
# Clave de cifrado en reposo de las credenciales OAuth (32 bytes, base64 o texto plano).
# Si se omite se deriva de JWT_SECRET con un warning en el log (no recomendado en producción).
EMAILIMPORT_ENCRYPTIONKEY=
# OAuth: ClientId/ClientSecret de un OAuth client de tipo "Web application" creado en
# Google Cloud Console (https://console.cloud.google.com/apis/credentials). El redirect URI
# a registrar es https://<tu-dominio>/api/email-import/connections/gmail/callback
EMAILIMPORT_PROVIDERS_GMAIL_CLIENTID=
EMAILIMPORT_PROVIDERS_GMAIL_CLIENTSECRET=
